<div class="detail-container">
  <a href="/casos/<%= caseRow.id %>" class="back-link"><i class="bi bi-arrow-left"></i> Volver al caso #<%= caseRow.id %></a>

  <div class="detail-header mt-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="mono" style="color:var(--accent); font-size:.95rem">#<%= ticket.id %></span>
      <span class="st <%= stClass(ticket.status) %>"><%= ticket.status || '—' %></span>
      <% if (ticket.priority) { %><span class="pr <%= prClass(ticket.priority) %>"><%= ticket.priority %></span><% } %>
      <span style="font-size:.75rem; color:var(--text-secondary); background:var(--bg-badge); padding:.2em .55em; border-radius:20px; font-weight:500"><%= ticket.ticket_type || 'Ticket' %></span>
    </div>
    <h1><%= ticket.subject %></h1>
    <% if (ticket.description) { %><p class="mt-1 mb-0" style="font-size:.85rem; color:var(--text-secondary)"><%= ticket.description %></p><% } %>
    <div class="meta mt-1 d-flex align-items-center gap-2 flex-wrap">
      <span>Caso padre: <a href="/casos/<%= caseRow.id %>" class="mono" style="color:var(--accent)">#<%= caseRow.id %></a> — <%= caseRow.subject %></span>
      <a href="https://mesaregistrocivil.cba.gov.ar/redmine/issues/<%= ticket.id %>" target="_blank" class="btn-act btn-act-lg btn-act-link">
        <i class="bi bi-box-arrow-up-right"></i> Redmine #<%= ticket.id %>
      </a>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap mt-2 pt-2 border-top">
      <% const resuelto = ['Cerrada','Cerrado','Resuelta','Resuelto'].includes(ticket.status); %>
      <% if (resuelto) { %>
        <form method="post" action="/tickets/<%= ticket.id %>/reopen">
          <input type="hidden" name="back" value="/tickets/<%= ticket.id %>">
          <button class="btn-act btn-act-lg btn-act-reopen"><i class="bi bi-arrow-counterclockwise"></i> Reabrir</button>
        </form>
      <% } else { %>
        <form method="post" action="/tickets/<%= ticket.id %>/resolve">
          <input type="hidden" name="back" value="/tickets/<%= ticket.id %>">
          <button class="btn-act btn-act-lg btn-act-resolve"><i class="bi bi-check-lg"></i> Marcar como resuelto</button>
        </form>
      <% } %>
      <button class="btn-act btn-act-lg btn-act-edit" data-bs-toggle="modal" data-bs-target="#modalEditar"><i class="bi bi-pencil-fill"></i> Editar</button>
      <form method="post" action="/tickets/<%= ticket.id %>/delete" onsubmit="return confirm('¿Eliminar el ticket #<%= ticket.id %> definitivamente?\n\nEsta acción no se puede deshacer.')">
        <button class="btn-act btn-act-lg btn-act-delete"><i class="bi bi-trash-fill"></i> Eliminar</button>
      </form>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="detail-section">
        <div class="head"><i class="bi bi-info-circle"></i> Información</div>
        <div class="body">
          <div class="row g-2">
            <% const fields = [
              ['Autor', ticket.author], ['Responsable', ticket.owner], ['Última act. de', ticket.last_updated_by],
              ['Módulo', ticket.module], ['Sistema', ticket.system || ticket.system_module],
              ['Trámite', ticket.procedure_name], ['Motivo', ticket.motive || ticket.motives], ['Motivo Mi RC', ticket.motive_mirc],
              ['Ambiente', ticket.environment], ['Paso', ticket.step], ['Sección', ticket.section],
              ['Nro. de Trámite', ticket.procedure_nums], ['Código SUAC', ticket.suac_code], ['N° Solicitud', ticket.request_number],
              ['Canal', ticket.contact_channel], ['Oficina', ticket.office],
              ['CUIL', ticket.cuil], ['Ficheros', ticket.files]
             ]; %>
            <% fields.filter(([_,v]) => v).forEach(([k,v]) => { %>
              <div class="col-md-6 meta"><%= k %>: <strong><%= v %></strong></div>
            <% }) %>
            <% if (fields.every(([_,v]) => !v)) { %><div class="text-muted" style="font-size:.82rem">Sin información adicional</div><% } %>
          </div>
        </div>
      </div>

      <!-- ARCHIVOS DEL TICKET -->
      <div class="detail-section" id="archivos">
        <div class="head"><i class="bi bi-paperclip"></i> Archivos <span class="ms-auto text-muted" style="font-weight:400; font-size:.78rem"><%= files.length %></span></div>
        <div class="body">
          <% if (files.length) { %>
            <div class="mb-3">
              <% files.forEach(f => { %>
                <div class="d-flex align-items-center gap-2 py-1 border-bottom" style="font-size:.83rem">
                  <i class="bi bi-file-earmark text-muted"></i>
                  <a href="/casos/<%= caseRow.id %>/files/<%= f.id %>/download" target="_blank" class="text-decoration-none flex-fill" style="color:var(--accent)"><%= f.name %></a>
                  <span class="text-muted" style="font-size:.72rem"><%= f.size ? (f.size / 1024).toFixed(0) + ' KB' : '' %></span>
                  <span class="text-muted" style="font-size:.72rem"><%= fmtDate(f.created_at) %></span>
                  <form method="post" action="/casos/<%= caseRow.id %>/files/<%= f.id %>/delete" class="d-inline" onsubmit="return confirm('¿Eliminar archivo?')">
                    <button class="btn btn-sm text-muted p-0" title="Eliminar"><i class="bi bi-trash" style="font-size:.75rem"></i></button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
          <form method="post" action="/casos/<%= caseRow.id %>/files" enctype="multipart/form-data">
            <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
            <div class="d-flex gap-2 align-items-center">
              <input type="file" name="files" multiple class="form-control form-control-sm" style="max-width:350px">
              <button class="btn btn-sm btn-primary"><i class="bi bi-upload"></i> Subir</button>
            </div>
          </form>
        </div>
      </div>

      <div class="detail-section">
        <div class="head"><i class="bi bi-arrow-repeat"></i> Cambiar estado</div>
        <div class="body">
          <form method="post" action="/tickets/<%= ticket.id %>/status" class="row g-2 align-items-end">
            <div class="col-md-5">
              <select class="form-select form-select-sm" name="status">
                <% ['Asignada','En Progreso','Verificar resolución','Pendiente','Cerrada'].forEach(s => { %>
                  <option <%= ticket.status===s?'selected':'' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4"><input class="form-control form-control-sm" name="actor" placeholder="Tu nombre"></div>
            <div class="col-md-3"><button class="btn btn-sm btn-primary w-100">Actualizar</button></div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="detail-section">
        <div class="head"><i class="bi bi-calendar-event"></i> Fechas</div>
        <div class="body">
          <% [['Creado', ticket.created_at], ['Inicio', ticket.started_at], ['Fin', ticket.finished_at], ['Cerrado', ticket.closed_at], ['Actualizado', ticket.updated_at]].forEach(([lbl,val]) => { %>
            <div class="d-flex justify-content-between py-1 border-bottom meta"><span><%= lbl %></span><strong><%= fmtDate(val) %></strong></div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL EDITAR TICKET -->
<div class="modal fade" id="modalEditar" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <form method="post" action="/tickets/<%= ticket.id %>/edit">
      <div class="modal-header py-2"><h6 class="modal-title">Editar ticket #<%= ticket.id %></h6><button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="row g-2">
          <div class="col-12"><label class="form-label small">Asunto</label>
            <input class="form-control form-control-sm" name="subject" required value="<%= ticket.subject || '' %>">
          </div>
          <div class="col-12"><label class="form-label small">Descripción</label>
            <textarea class="form-control form-control-sm" name="description" rows="3"><%= ticket.description || '' %></textarea>
          </div>
          <div class="col-md-4"><label class="form-label small">Tipo</label>
            <input class="form-control form-control-sm" name="ticket_type" value="<%= ticket.ticket_type || '' %>">
          </div>
          <div class="col-md-4"><label class="form-label small">Prioridad</label>
            <select class="form-select form-select-sm" name="priority">
              <option value="">—</option>
              <% ['Baja','Media','Alta','Muy alta','Inmediata - 8hrs'].forEach(pr => { %>
                <option <%= ticket.priority===pr?'selected':'' %>><%= pr %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4"><label class="form-label small">Responsable</label>
            <input class="form-control form-control-sm" name="owner" list="dl-operadores" value="<%= ticket.owner || '' %>">
          </div>
          <div class="col-md-4"><label class="form-label small">Autor</label>
            <input class="form-control form-control-sm" name="author" list="dl-autores" value="<%= ticket.author || '' %>">
          </div>
          <div class="col-md-4"><label class="form-label small">Trámite</label>
            <input class="form-control form-control-sm" name="tramite" list="dl-tramites" value="<%= ticket.procedure_name || '' %>">
          </div>
          <div class="col-md-4"><label class="form-label small">Paso</label>
            <input class="form-control form-control-sm" name="paso" list="dl-pasos" value="<%= ticket.step || '' %>">
          </div>
          <div class="col-md-4"><label class="form-label small">Oficina</label>
            <input class="form-control form-control-sm" name="oficina" list="dl-oficinas" value="<%= ticket.office || '' %>">
          </div>
          <div class="col-md-4"><label class="form-label small">Módulo</label>
            <input class="form-control form-control-sm" name="module" list="dl-modulos" value="<%= ticket.module || '' %>">
          </div>
        </div>
        <p class="text-muted small mt-2 mb-0">El estado se cambia desde los botones de arriba o el panel "Cambiar estado".</p>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn-act btn-act-lg btn-act-edit"><i class="bi bi-check-lg"></i> Guardar cambios</button>
      </div>
    </form>
  </div></div>
</div>

<datalist id="dl-operadores"><% cfgOperadores.forEach(o => { %><option value="<%= o %>"><% }) %></datalist>
<datalist id="dl-autores"><% cfgAutores.forEach(a => { %><option value="<%= a %>"><% }) %></datalist>
<datalist id="dl-tramites"><% cfgTramites.forEach(t => { %><option value="<%= t %>"><% }) %></datalist>
<datalist id="dl-pasos"><% cfgPasos.forEach(p => { %><option value="<%= p %>"><% }) %></datalist>
<datalist id="dl-oficinas"><% cfgOficinas.forEach(o => { %><option value="<%= o %>"><% }) %></datalist>
<datalist id="dl-modulos"><% cfgModulos.forEach(m => { %><option value="<%= m %>"><% }) %></datalist>

<script>
  // Permite abrir el modal directo con /tickets/123#editar (link desde el caso).
  if (location.hash === '#editar') {
    new bootstrap.Modal(document.getElementById('modalEditar')).show();
  }
</script>
